APP_ENV=dev
COMPOSE_PROJECT_NAME=butake-service-maps-dev


GATEWAY_IMAGE=nginx:1.27.5-alpine
MAPS_IMAGE=maptiler/tileserver-gl-light:v4.4.2
ROUTING_IMAGE=israelhikingmap/graphhopper:11.0

MAPS_PORT=8085
ROUTING_PORT=8989
MAPS_BIND_HOST=0.0.0.0
ROUTING_BIND_HOST=0.0.0.0
MAPS_MEMORY_LIMIT=512m
ROUTING_MEMORY_LIMIT=3g
ROUTING_JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError"

MAPS_PUBLIC_URL=http://localhost:8085
MAPS_CONFIG_FILE=/data/config.json
MAPS_PRIMARY_TILESET=chile.mbtiles
MAPS_BACKGROUND_TILESET=natural_earth.mbtiles

ROUTING_CONFIG_FILE=/config/config.yml
ROUTING_OSM_FILE=/data/map.osm.pbf

DATA_PATH=./data
ACTIVE_COUNTRY=chile

# 1 = actualizar rutas en azul/verde sin caída (requiere RAM para dos GraphHopper, ~8 GB)
# 0 = reimportar en el mismo contenedor (unos minutos sin rutas; máquinas de 4 GB)
ROUTING_ZERO_DOWNTIME=1
