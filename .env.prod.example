APP_ENV=prod
COMPOSE_PROJECT_NAME=butake-service-maps

MAPS_SHARED_NETWORK=butake-service-shared

GATEWAY_IMAGE=nginx:1.27.5-alpine
MAPS_IMAGE=maptiler/tileserver-gl-light:v4.4.2
ROUTING_IMAGE=israelhikingmap/graphhopper:11.0

MAPS_PORT=8080
ROUTING_PORT=8989
MAPS_BIND_HOST=0.0.0.0
ROUTING_BIND_HOST=0.0.0.0
MAPS_MEMORY_LIMIT=512m
# El heap es el 75 % de este límite (ROUTING_JAVA_OPTS). Con 3G (heap 2,25 GB) la importación
# de Chile se cae por falta de memoria y Docker la reinicia en bucle; con 6g sobra. En reposo ~2 GB.
ROUTING_MEMORY_LIMIT=6g
ROUTING_JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError"

MAPS_PUBLIC_URL=https://mapas.ejemplo.cl
MAPS_CONFIG_FILE=/data/config.json
MAPS_PRIMARY_TILESET=chile.mbtiles
MAPS_BACKGROUND_TILESET=natural_earth.mbtiles

ROUTING_CONFIG_FILE=/config/config.yml
ROUTING_OSM_FILE=/data/map.osm.pbf

DATA_PATH=./data
ACTIVE_COUNTRY=chile

# 1 = actualizar rutas en azul/verde sin caída: el color activo (~2 GB) y el que importa
#     (hasta ROUTING_MEMORY_LIMIT) corren juntos; con 6g, máquinas de 12 GB o más
# 0 = reimportar en el mismo contenedor (unos minutos sin rutas; máquinas de 8 GB)
ROUTING_ZERO_DOWNTIME=1
